# ==============================================================================
# Deep Reader Backend — Пример конфигурации переменных окружения (.env)
# Скопируйте этот файл в .env и укажите ваши параметры: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Серверные параметры
# ------------------------------------------------------------------------------
PORT=8080
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Подключение к PostgreSQL и пул соединений HikariCP
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_INTERNAL_PORT=5432
DB_NAME=deep_reader
DB_USERNAME=postgres
DB_PASSWORD=postgres

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/deep_reader
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

DB_POOL_MAX=10
DB_POOL_MIN=2
SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# ------------------------------------------------------------------------------
# 3. Настройки AI и внешних провайдеров
# ------------------------------------------------------------------------------
# Провайдер LLM: 'openai' (по умолчанию) или 'mock' (для тестов/офлайн-разработки)
AI_LLM_PROVIDER=openai

# Провайдер перевода: 'deepl' (по умолчанию) или 'mock' (для тестов/офлайн-разработки)
AI_TRANSLATOR_PROVIDER=deepl

# Максимальный бюджет токенов на окружающий контекст (в BPE-токенах)
AI_MAX_CONTEXT_TOKENS=1000

# ------------------------------------------------------------------------------
# 4. OpenAI API (или локальный vLLM / Ollama)
# ------------------------------------------------------------------------------
# Базовый URL: для локального Ollama/vLLM можно указать http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=12

# ------------------------------------------------------------------------------
# 5. DeepL Translation API
# ------------------------------------------------------------------------------
# Ключ DeepL: суффикс ':fx' автоматически направляет трафик на api-free.deepl.com,
# иначе используется Pro-хост api.deepl.com
DEEPL_API_KEY=your-deepl-api-key-here:fx
DEEPL_TIMEOUT_SECONDS=3

# ------------------------------------------------------------------------------
# 6. Параметры двухуровневого кэша (L1 Caffeine + L2 PostgreSQL UNLOGGED)
# ------------------------------------------------------------------------------
# Срок жизни кэша литературных разборов (дней)
EXPLAIN_CACHE_TTL_DAYS=30

# Срок жизни кэша переводов (дней)
TRANSLATE_CACHE_TTL_DAYS=90

# Максимальное количество записей в оперативной памяти L1 (Caffeine LRU)
CACHE_L1_MAX_SIZE=10000

# Время жизни записей в L1 до выгрузки в L2 (часов)
CACHE_L1_TTL_HOURS=1
