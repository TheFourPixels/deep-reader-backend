        {
          "expr": "(((sum(rate(http_server_requests_seconds_count{status!~\"5..\", uri=~\"/api/.*\"}[1m])) default 0) / (sum(rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m])) > 0) >= 0.995) and ((sum(rate(http_server_requests_seconds_sum{uri=~\"/api/.*\"}[1m])) default 0) / (sum(rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m])) > 0) <= 0.200)) or on() vector(0)",
          "legendFormat": "Good Minute",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          },
          "min": 0,
          "max": 1.2
        }
