          "expr": "avg_over_time((((sum(rate(http_server_requests_seconds_count{status!~\"5..\", uri=~\"/api/.*\"}[1m])) default 0) / (sum(rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m])) > 0) >= 0.995) and ((sum(rate(http_server_requests_seconds_sum{uri=~\"/api/.*\"}[1m])) default 0) / (sum(rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m])) > 0) <= 0.200) or on() vector(0))[30m]) * 100",
          "legendFormat": "Cumulative TBSLO",
          "refId": "A"
        },
